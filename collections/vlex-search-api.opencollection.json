            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Ocp-Apim-Subscription-Key",
              "value": "{{Ocp-Apim-Subscription-Key}}",
              "placement": "header"
            }
          },
          "docs": "Perform a semantic search across the vLex corpus of 100+ million legal documents. Supports natural language queries with jurisdiction, document type, and date filters. Returns ranked results with document metadata."
        }
      ]
    }
  ],
  "bundled": true
