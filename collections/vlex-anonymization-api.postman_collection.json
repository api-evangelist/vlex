        {
          "id": "5238c516-8ecd-4ddf-add5-88b57a3fdf54",
          "name": "Anonymize Text",
          "request": {
            "name": "Anonymize Text",
            "description": {
              "content": "Accepts a text input and identifies all personally identifiable information (names, organizations, and other sensitive entities). Returns the original text with identified entities replaced or tagged for anonymization. Pre-trained on legal data to handle case law, contracts, and regulatory documents.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "anonymize"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "Ocp-Apim-Subscription-Key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"<string>\",\n  \"mode\": \"replace\",\n  \"replacement_token\": \"[REDACTED]\",\n  \"entity_types\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"language\": \"en\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
